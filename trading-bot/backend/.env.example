# Backend Environment Configuration for AI Trading Bot
# Copy this file to .env in the backend directory

# Application Settings
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-super-secret-key-here-change-in-production
APP_NAME=AI Trading Bot
APP_VERSION=1.0.0

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=true

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/tradingbot
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
CORS_CREDENTIALS=true

# Broker API Keys
ANGEL_ONE_API_KEY=your-angel-one-api-key
ANGEL_ONE_CLIENT_ID=your-angel-one-client-id
ANGEL_ONE_SECRET=your-angel-one-secret

ZERODHA_API_KEY=your-zerodha-api-key
ZERODHA_SECRET=your-zerodha-secret

UPSTOX_API_KEY=your-upstox-api-key
UPSTOX_SECRET=your-upstox-secret

BINANCE_API_KEY=your-binance-api-key
BINANCE_SECRET=your-binance-secret

# External API Keys
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key
NEWS_API_KEY=your-news-api-key
POLYGON_API_KEY=your-polygon-api-key
FINNHUB_API_KEY=your-finnhub-api-key

# AI/ML Configuration
TENSORFLOW_SERVING_URL=http://localhost:8501
HUGGINGFACE_API_KEY=your-huggingface-api-key
OPENAI_API_KEY=your-openai-api-key

# Notification Services
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@aitradingbot.com

TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Webhook Configuration
WEBHOOK_SECRET=your-webhook-secret

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/var/log/tradingbot.log

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=20

# Background Tasks
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_WORKER_CONCURRENCY=4

# Market Data Configuration
MARKET_DATA_REFRESH_INTERVAL=1000
PORTFOLIO_REFRESH_INTERVAL=5000
NEWS_REFRESH_INTERVAL=30000

# Risk Management
MAX_POSITION_SIZE=1000000
MAX_DAILY_LOSS=50000
MAX_DRAWDOWN_PERCENT=10
RISK_CHECK_INTERVAL=5000

# Performance Monitoring
SENTRY_DSN=your-sentry-dsn
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# File Upload
MAX_FILE_SIZE=10485760  # 10MB
UPLOAD_DIRECTORY=/tmp/uploads
ALLOWED_EXTENSIONS=json,csv,xlsx,xls

# Cache Configuration
CACHE_DEFAULT_TIMEOUT=300
CACHE_THRESHOLD=500
CACHE_KEY_PREFIX=tradingbot

# Session Configuration
SESSION_TIMEOUT=28800  # 8 hours
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
