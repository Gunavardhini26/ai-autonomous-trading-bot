# Environment Configuration for AI Trading Bot
# Copy this file to .env in the frontend directory

# Application Environment
REACT_APP_ENVIRONMENT=development
REACT_APP_VERSION=1.0.0

# API Configuration
REACT_APP_API_URL=http://localhost:8000/api
REACT_APP_WS_URL=ws://localhost:8000/ws
REACT_APP_API_TIMEOUT=30000

# Feature Flags
REACT_APP_ENABLE_PAPER_TRADING=true
REACT_APP_ENABLE_CRYPTO_TRADING=true
REACT_APP_ENABLE_OPTIONS_TRADING=true
REACT_APP_ENABLE_AI_PREDICTIONS=true
REACT_APP_ENABLE_SENTIMENT_ANALYSIS=true
REACT_APP_ENABLE_ADVANCED_CHARTS=true
REACT_APP_ENABLE_NOTIFICATIONS=true

# Theme Configuration
REACT_APP_DEFAULT_THEME=dark
REACT_APP_ENABLE_THEME_TOGGLE=true

# Analytics & Tracking
REACT_APP_GOOGLE_ANALYTICS_ID=
REACT_APP_MIXPANEL_TOKEN=
REACT_APP_SENTRY_DSN=

# Development Settings
REACT_APP_DEBUG_MODE=true
REACT_APP_MOCK_DATA=false
REACT_APP_ENABLE_DEVTOOLS=true

# Security
REACT_APP_ENABLE_CSP=true
REACT_APP_ENABLE_HTTPS_REDIRECT=false

# Performance
REACT_APP_ENABLE_SERVICE_WORKER=false
REACT_APP_ENABLE_LAZY_LOADING=true
REACT_APP_ENABLE_CODE_SPLITTING=true
