# Angel One API Configuration (Required for live trading)
# Get these from your Angel One account
ANGEL_ONE_API_KEY=your_angel_one_api_key_here
ANGEL_ONE_CLIENT_ID=your_client_id_here
ANGEL_ONE_PIN=your_trading_pin_here

# Alpha Vantage API (Required for historical data and technical indicators)
# Get free API key from: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# News API (Required for news sentiment analysis)
# Get free API key from: https://newsapi.org/register
NEWS_API_KEY=your_news_api_key_here

# Database Configuration (Default values for Docker setup)
DATABASE_URL=postgresql://postgres:postgres123@postgres:5432/trading_bot
REDIS_URL=redis://redis:6379

# JWT Secret for authentication (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=http://localhost:8000

# Optional: Environment setting
ENVIRONMENT=development
DEBUG=True
